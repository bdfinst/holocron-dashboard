{
  "name": "holocron-dashboard",
  "version": "1.0.39",
  "private": true,
  "scripts": {
    "build": "vite build",
    "coverage": "jest --ci --coverage --watchAll=false --env=jsdom --maxWorkers=50%",
    "format:fix": "prettier --write '**/*.{js,jsx,yml,json,css,md}'",
    "lint": "eslint --cache --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "concurrently 'npm run lint:js' 'npm run format:fix'",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite",
    "start:docker": "vite --host=0.0.0.0",
    "test": "npm run coverage",
    "test:e2e-ci": "cypress run --browser chrome --config-file cypress/config/config.config.ts --config baseUrl=http://localhost",
    "cypress:open": "cypress open --browser chrome --config-file cypress/config/config.config.ts --config baseUrl=http://localhost",
    "cypress:run": "cypress run --browser chrome --config-file cypress/config/config.config.ts --config baseUrl=http://localhost",
    "test:ci": "jest --ci --watchAll=true --env=jsdom",
    "test:unit": "npm run coverage",
    "precommit-hook": "npm run lint:js && npm run test:unit"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@types/papaparse": "^5.5.1",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.13.2",
    "local-storage": "^2.0.0",
    "loglevel": "^1.9.2",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-markdown": "^9.1.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.26",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cypress": "^13.17.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-etc": "^2.0.3",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-testing-library": "^6.5.0",
    "history": "^5.3.0",
    "husky": "^9.1.7",
    "import-sort-style-absolute": "^1.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "miragejs": "^0.1.48",
    "mkdirp": "^3.0.1",
    "prettier": "^3.7.4",
    "react-test-renderer": "^18.3.1",
    "tcp-port-used": "^1.0.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "importSort": {
    ".js, .jsx": {
      "parser": "babylon",
      "style": "absolute",
      "options": {}
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
