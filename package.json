{
  "name": "holocron-dashboard",
  "version": "1.0.39",
  "private": true,
  "scripts": {
    "build": "webpack --mode=production --progress",
    "coverage": "jest --ci --coverage --watchAll=false --env=jsdom --maxWorkers=50%",
    "format:fix": "prettier --write '**/*.{js,jsx,yml,json,css,md}'",
    "lint": "eslint --cache --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "concurrently 'npm run lint:js' 'npm run format:fix'",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx . --fix",
    "postinstall": "husky install",
    "start": "webpack serve --mode=development",
    "start:docker": "webpack serve --mode=development --host=0.0.0.0",
    "test": "npm run coverage",
    "test:e2e-ci": "cypress run --browser chrome --config-file cypress/config/config.config.ts --config baseUrl=http://localhost",
    "cypress:open": "cypress open --browser chrome --config-file cypress/config/config.config.ts --config baseUrl=http://localhost",
    "cypress:run": "cypress run --browser chrome --config-file cypress/config/config.config.ts --config baseUrl=http://localhost",
    "test:ci": "jest --ci --watchAll=true --env=jsdom",
    "test:unit": "npm run coverage",
    "precommit-hook": "npm run lint:js && npm run test:unit"
  },
  "dependencies": {
    "@emotion/cache": "^11.7.1",
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@mui/icons-material": "^5.1.0",
    "@mui/material": "^5.15.4",
    "@types/papaparse": "^5.3.7",
    "autosuggest-highlight": "^3.2.0",
    "axios": "^1.3.5",
    "local-storage": "^2.0.0",
    "loglevel": "^1.7.1",
    "papaparse": "^5.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.3",
    "react-markdown": "^9.0.1",
    "react-query": "^3.21.0",
    "react-router-dom": "^6.19.0",
    "recharts": "^2.0.9",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@babel/eslint-parser": "^7.19.1",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-modules-commonjs": "^7.21.2",
    "@babel/plugin-transform-runtime": "^7.19.6",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/runtime": "^7.20.6",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "@types/webpack": "^5.28.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.1.0",
    "babel-loader": "^9.1.2",
    "babel-polyfill": "^6.26.0",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "cypress": "^13.15.0",
    "eslint": "^8.37.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-etc": "^2.0.2",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jest": "^28.0.0",
    "eslint-plugin-jest-dom": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.23.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-testing-library": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "history": "^5.3.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^9.0.0",
    "import-sort-style-absolute": "^1.0.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "miragejs": "^0.1.43",
    "mkdirp": "^3.0.0",
    "prettier": "^3.0.0",
    "raw-loader": "^4.0.2",
    "react-test-renderer": "^18.2.0",
    "svg-url-loader": "^8.0.0",
    "tcp-port-used": "^1.0.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "typescript": "^5.0.0",
    "webpack": "^5.68.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^5.0.0"
  },
  "importSort": {
    ".js, .jsx": {
      "parser": "babylon",
      "style": "absolute",
      "options": {}
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
